---
import Site from '../layouts/Site.astro';
import { content, labels, type Language } from '../lib/site';

interface Props { lang: Language; page: 'about' | 'projects' }
const { lang, page } = Astro.props;
const title = labels[lang][page];
---
<Site lang={lang} title={title} languagePath={`${lang === 'en' ? '' : 'en/'}${page === 'about' ? 'about' : 'work'}/`}>
  <article class="page">
    <h1>{title}</h1>
    {page === 'about' ? content.about[lang] && <p>{content.about[lang]}</p> : <ul class="project-list">
      {content.projects.map((project) => <li><a href={project.url}>{project.name}</a><p>{project.description[lang]}</p></li>)}
    </ul>}
  </article>
</Site>
